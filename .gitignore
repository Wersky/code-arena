# Godot 缓存（体积大、可重建）
.godot/
*.translation

# 临时目录
.tmp/
.tmp-t2/
*.tmp

# 协作工具的本地状态
.swarmbridge/

# CodeArts 技能发现入口（junction → .zcode/skills，跨机器用 tools/link_skills.bat 重建）
.github/skills/

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

# 导出的游戏本体（105 MB，别进仓库）
dist/
tools/__pycache__/

# 本机工作文件（不入公开仓库）
圆桌纪要/
probe_*.gd*
*.bak-*

# Web 导出产物与 Worker 本地密钥
build/
worker/.dev.vars
worker/.wrangler/
# tools/stage_web.py 生成的部署目录（82MB，每次打包重建，不进仓库）
worker/public/
