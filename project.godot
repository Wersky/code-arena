; Engine configuration file.
; It's best edited using the editor UI and not directly,
; as some parameters change regularly.

config_version=5

[application]

config/name="代码擂台 Code Arena"
config/description="2D 肉鸽扑克：选一位 AI 娘，把牌凑成德州牌型打出去，筹码 × 倍率过关。纯鼠标操作。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

; 像素风：贴图一律最近邻采样，避免糊
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=0

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.063, 0.09, 1)
